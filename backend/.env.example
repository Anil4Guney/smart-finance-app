# Copy to backend/.env for local development. On Render/production set these
# as environment variables in the dashboard instead.

# Local development only. Leave unset (or False) in production.
DJANGO_DEBUG=True

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated host names the backend answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated front-end URLs allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL in production, e.g. postgres://user:pass@host:5432/dbname
# Leave empty locally to use SQLite.
DATABASE_URL=

# Google Gemini API key (AI advisor + receipt scanning)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: model name (default gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
# Optional: faster model for the chat (default gemini-flash-lite-latest) and its time limit
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# AI_CHAT_TIMEOUT_SECONDS=45

# Optional request limits per user for the AI endpoints
# AI_CHAT_RATE=30/hour
# RECEIPT_SCAN_RATE=20/hour
